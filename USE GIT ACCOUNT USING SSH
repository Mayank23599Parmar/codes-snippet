ssh-keygen -t ed25519 -C "personal@email.com"
Enter file in which to save the key: ~/.ssh/id_ed25519_personal
ssh-keygen -t ed25519 -C "work@company.com"
Save the key in: ~/.ssh/id_ed25519_work
pbcopy < ~/.ssh/id_ed25519.pub

cat ~/.ssh/id_ed25519.pub

ssh-add ~/.ssh/id_ed25519_personal   
ssh-add ~/.ssh/id_ed25519

# Personal GitHub
Host github-personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentitiesOnly yes

# Work GitHub
Host github-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

  git@github-personal:Mayank23599Parmar/ipconfig.git
